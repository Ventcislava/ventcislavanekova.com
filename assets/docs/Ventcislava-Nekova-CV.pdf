1747 0 obj
  << /ActualText (DIRECTOR \046 RESEARCHER \174 Echoes of Motion \046 Echoes of Connection \024 Research Essay \046 Dance Film \n\050Research\055led project exploring movement as a form of communication and design\054 examining the impact of digital environments on bodies\054 perception\054 and social connection\056\050Developed through experiential research including movement workshops\054 motion\055tracking experiments\054 3D scanning\054 interviews\054 and community\055based exploration with participants of varying ages and movement backgrounds\056\050The research culminated in\240Echoes of Connection\054 a short dance film translating theoretical inquiry into embodied practice through choreography\054 gesture\054 and spatial awareness\056\n\nPresented at\072 Shoreditch Art Center \nCollaborators\072 Emma Poyer\054 Sophia Morton\054 Anastasia Kozlova\050)
     /K [ 10 ]
     /P 1748 0 R
     /Pg 1727 0 R
     /S /Span
     /Type /StructElem
  >>
endobj

1748 0 obj
  << /K [ 1747 0 R ]
     /P 1763 0 R
     /S /P
     /Pg 1727 0 R
     /Type /StructElem
  >>
endobj

1749 0 obj
  << /ActualText (REWIRING INTIMACY\240\023 Immersive Installation\nRoyal College of Art and Frameless\054 London\054 March 2025\n\050Collaborative research project exploring intimacy\054 agency\054 and responsiveness through movement and interactive technology\056\050Developed through studio\055based experimentation\054 rehearsals\054 and writing\054  and a performative exploration between dancers and a responsive humanoid object\054 that was created together\056\050Presented as a research performance investigating the dialogue between body\054 system\054 and control\056\n\050Presented at\072 Selected at the Across RCA Exhibition\050Collaborators\072 Bernice Wong\054 J Mina\054 Ben Roe and Riichiro Yamamoto\056 )
     /K [ 11 ]
     /P 1750 0 R
     /Pg 1727 0 R
     /S /Span
     /Type /StructElem
  >>
endobj

